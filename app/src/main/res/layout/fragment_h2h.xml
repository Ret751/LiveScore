<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101411"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:background="#1A1F1B">

        <TextView android:id="@+id/tvHomeWins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#20E07A" android:textSize="24sp" android:text="0"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#888888" android:text=" 승  " />
        <TextView android:id="@+id/tvDraws" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="24sp" android:text="0"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#888888" android:text=" 무  " />
        <TextView android:id="@+id/tvAwayWins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF4D4D" android:textSize="24sp" android:text="0"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#888888" android:text=" 승" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="최근 맞대결 결과"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvH2HMatches"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>